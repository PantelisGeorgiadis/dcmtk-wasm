{
  "name": "dcmtk-wasm",
  "version": "0.0.1",
  "description": "DICOM dataset parsing and image rendering module based on WebAssembly and DCMTK",
  "main": "build/dcmtk-wasm.min.js",
  "module": "build/dcmtk-wasm.min.js",
  "scripts": {
    "build": "npm run version && npm run lint && npm run test && npm run coverage && npm run webpack",
    "clean": "npm run clean:build && npm run clean:coverage",
    "clean:build": "shx rm -rf build",
    "clean:coverage": "shx rm -rf coverage",
    "coverage": "c8 --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 --clean --reporter=text --reporter=html --include=src/*.js --exclude=src/index.js --exclude=src/version.js --exclude=src/log.js mocha test/**/*.test.js",
    "format:cpp": "clang-format -style=file:.clang-format -i \"--glob=wasm/src/**/*.@(cpp|h)\"",
    "lint": "eslint -c .eslintrc.json --fix src && prettier --tab-width 2 --single-quote true --print-width 100 --use-tabs false --trailing-comma es5 --write src/ test/ *.{js,md} examples/*.html",
    "start": "npm run webpack",
    "start:examples:web": "webpack serve --port 8080 --open --no-client-overlay-warnings --no-client-overlay-errors",
    "test": "npm run test:node && npm run test:browser",
    "test:browser": "karma start karma.config.js",
    "test:node": "mocha test/**/*.test.js",
    "version": "node -p -e \"'module.exports = \\'' + require('./package.json').version + '\\';'\" > src/version.js",
    "webpack": "webpack --progress --config webpack.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PantelisGeorgiadis/dcmtk-wasm.git"
  },
  "keywords": [
    "DICOM",
    "DCMTK",
    "medical imaging"
  ],
  "author": "Pantelis Georgiadis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PantelisGeorgiadis/dcmtk-wasm/issues"
  },
  "homepage": "https://github.com/PantelisGeorgiadis/dcmtk-wasm",
  "dependencies": {
    "loglevel": "^1.8.1",
    "loglevel-plugin-prefix": "^0.8.4",
    "uwasi": "^1.5.2"
  },
  "devDependencies": {
    "browserify": "^17.0.0",
    "c8": "^8.0.0",
    "chai": "^4.3.7",
    "clang-format": "^1.8.0",
    "copy-webpack-plugin": "^11.0.0",
    "dcmjs": "^0.52.0",
    "eslint": "^8.45.0",
    "karma": "^6.4.2",
    "karma-browserify": "^8.1.0",
    "karma-chai": "^0.1.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "karma-sinon": "^1.0.5",
    "mocha": "^10.2.0",
    "pako": "^2.1.0",
    "prettier": "^3.0.0",
    "shx": "^0.3.4",
    "sinon": "^15.2.0",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "overrides": {
    "yargs": "^17.7.2"
  }
}
